VITE_FIREBASE_API_KEY=
# Local development: the default *.firebaseapp.com value from the Firebase
# console works fine here.
#
# Production (Vercel): must be the canonical frontend domain itself
# (the-noted-app.vercel.app), not the default Firebase domain -- otherwise
# Google/email auth runs cross-origin from the app and its redirect
# handshake can silently fail (this is set as a Vercel project environment
# variable for the Production environment, not in this file). See
# vercel.json's /__/auth/* proxy, which is what makes that same-origin
# value work.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_API_KEY=
# Local development: the default *.firebaseapp.com value from the Firebase
# console works fine here.
#
# Production (Vercel): must be the canonical frontend domain itself (this
# project's production Vercel domain), not the default Firebase domain --
# otherwise Google/email auth runs cross-origin from the app and its
# redirect handshake can silently fail (this is set as a Vercel project
# environment variable for the Production environment, not in this file).
# See vercel.json's /__/auth/* proxy, which is what makes that same-origin
# value work -- its rewrite destination must point at this same Firebase
# project's authDomain.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional temporary test flag. When "true", forces the full pre-auth
# onboarding/orientation to show on every fresh app load -- including one
# that restores an already-authenticated session -- ignoring any stored
# completion on this device, for repeatedly testing that flow without
# clearing site data. Safe to set temporarily in any environment, including
# Production, while testing; leave blank/unset otherwise so normal behavior
# applies.
VITE_FORCE_ONBOARDING=

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Shared by the legacy tracker/config doc and every ledgers/{id} doc --
    // both are just a short display name with the same shape.
    function isTrackerName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 60
        && name.matches('.*\\S.*');
    }

    function isDayState(state) {
      return state in ['did', 'didnt'];
    }

    function isStateLabel(label) {
      return label is string
        && label.size() > 0
        && label.size() <= 24
        && label.matches('.*\\S.*');
    }

    // stateLabels is presentation-only wording for the two DayState values;
    // it is optional (unset trackers fall back to default wording) but
    // when present must carry both keys with a valid label each.
    function isValidOptionalStateLabels(data) {
      return !hasKey(data, 'stateLabels')
        || (
          data.stateLabels.keys().hasOnly(['did', 'didnt'])
          && data.stateLabels.keys().hasAll(['did', 'didnt'])
          && isStateLabel(data.stateLabels.did)
          && isStateLabel(data.stateLabels.didnt)
        );
    }

    // A ledger's optional identifying color: a small fixed palette (see
    // domain/ledger.ts's LEDGER_COLORS), never freeform hex/strings.
    function isLedgerColor(color) {
      return color in ['espresso', 'clay', 'moss', 'dust', 'plum', 'rose', 'straw'];
    }

    function isValidOptionalLedgerColor(data) {
      return !hasKey(data, 'color') || isLedgerColor(data.color);
    }

    // -- Daily entry helpers -------------------------------------------
    // A daily document is an exception/context record: every field on it
    // is optional except updatedAt, and at least one of state/note/count
    // must be present (otherwise the document should not exist at all).

    function hasKey(data, key) {
      return key in data.keys();
    }

    function hasAtLeastOneExplicitDailyField(data) {
      return hasKey(data, 'state') || hasKey(data, 'note') || hasKey(data, 'count');
    }

    function isValidOptionalState(data) {
      return !hasKey(data, 'state') || isDayState(data.state);
    }

    function isValidNote(note) {
      return note is string
        && note.size() > 0
        && note.size() <= 120
        && note.matches('.*\\S.*');
    }

    function isValidOptionalNote(data) {
      return !hasKey(data, 'note') || isValidNote(data.note);
    }

    function isValidCount(count) {
      return count is int && count >= 2 && count <= 99;
    }

    // A count's validity depends on the day's *effective* state, which
    // requires the tracker's configured default when no explicit state is
    // present on this write.
    function effectiveDailyState(uid, data) {
      return hasKey(data, 'state')
        ? data.state
        : get(/databases/$(database)/documents/users/$(uid)/tracker/config).data.defaultState;
    }

    function isValidOptionalCount(uid, data) {
      return !hasKey(data, 'count')
        || (isValidCount(data.count) && effectiveDailyState(uid, data) == 'did');
    }

    // Same idea as isValidOptionalCount above, but for a day that belongs
    // to a ledgers/{ledgerId} document instead of the legacy tracker/config.
    function effectiveLedgerDailyState(uid, ledgerId, data) {
      return hasKey(data, 'state')
        ? data.state
        : get(/databases/$(database)/documents/users/$(uid)/ledgers/$(ledgerId)).data.defaultState;
    }

    function isValidOptionalLedgerCount(uid, ledgerId, data) {
      return !hasKey(data, 'count')
        || (isValidCount(data.count) && effectiveLedgerDailyState(uid, ledgerId, data) == 'did');
    }

    match /users/{uid} {

      // Single tracker config per user, at a fixed document id so no
      // alternate path can create a second tracker for the same user.
      match /tracker/config {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'stateLabels', 'createdAt', 'updatedAt']
             )
          && request.resource.data.keys().hasAll(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && isDateKey(request.resource.data.startDate)
          && isValidOptionalStateLabels(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Only name, defaultState, stateLabels, and updatedAt may change
        // after creation. defaultState is user-correctable from Settings;
        // the client pins each day's current state onto its own document
        // before this write, so no already-recorded day's meaning
        // changes -- only days with no document re-resolve. stateLabels is
        // presentation-only wording and never affects that resolution.
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'stateLabels', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone == resource.data.timezone
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidOptionalStateLabels(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        // The client deletes this doc when the ledgers/default ledger it
        // was migrated into is itself deleted (see data/ledger.ts's
        // deleteLedger) -- otherwise a fresh session's migration check
        // would find it still present and resurrect that deleted ledger.
        allow delete: if isOwner(uid);
      }

      // No other documents are permitted under tracker/.
      match /tracker/{document} {
        allow read, write: if false;
      }

      // A daily document represents only the explicit, non-default facts
      // for that day (state override, note, occurrence count); it is
      // fully replaced or removed, never partially patched.
      match /days/{dayId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isDateKey(dayId)
          && request.resource.data.keys().hasAll(['updatedAt'])
          && request.resource.data.keys().hasOnly(['state', 'note', 'count', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && hasAtLeastOneExplicitDailyField(request.resource.data)
          && isValidOptionalState(request.resource.data)
          && isValidOptionalNote(request.resource.data)
          && isValidOptionalCount(uid, request.resource.data);

        allow delete: if isOwner(uid);
      }

      // Multiple independent ledgers per user (each roughly what a single
      // "tracker" used to be, plus an optional identifying color). Exactly
      // one is ever the active/viewed one on the client -- see settings/app
      // below; this collection only holds each ledger's own configuration,
      // its daily entries live in the days/ subcollection beneath it.
      //
      // Accounts that predate multi-ledger support are migrated by the
      // client into exactly one ledger with the fixed id "default" (see
      // data/ledger.ts). That migration only ever creates this small
      // pointer document -- it never moves or deletes the legacy
      // users/{uid}/days data, which stays governed by the days/{dayId}
      // rules above for that one ledger id specifically. Every other
      // ledger, including a brand-new account's first one, stores its days
      // under ledgers/{ledgerId}/days/{dayId} below instead.
      match /ledgers/{ledgerId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'color', 'defaultState', 'timezone', 'startDate', 'stateLabels', 'createdAt', 'updatedAt']
             )
          && request.resource.data.keys().hasAll(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isValidOptionalLedgerColor(request.resource.data)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && isDateKey(request.resource.data.startDate)
          && isValidOptionalStateLabels(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Only name, color, defaultState, stateLabels, and updatedAt may
        // change after creation -- same reasoning as tracker/config's
        // update rule above (the client pins each day's current state
        // before changing defaultState, so no recorded day's meaning
        // silently shifts).
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'color', 'defaultState', 'timezone', 'startDate', 'stateLabels', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isValidOptionalLedgerColor(request.resource.data)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone == resource.data.timezone
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidOptionalStateLabels(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        // Removing a ledger is a real product action (see the ledger
        // switcher's "Delete"); the client deletes its days first via the
        // days/{dayId} rules below, then this doc.
        allow delete: if isOwner(uid);

        // Shares its exact shape and validation with the legacy
        // users/{uid}/days/{dayId} rule above; only the source of the
        // effective-default-state lookup differs (this ledger's own doc,
        // not tracker/config).
        match /days/{dayId} {
          allow read: if isOwner(uid);

          allow create, update: if isOwner(uid)
            && isDateKey(dayId)
            && request.resource.data.keys().hasAll(['updatedAt'])
            && request.resource.data.keys().hasOnly(['state', 'note', 'count', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && hasAtLeastOneExplicitDailyField(request.resource.data)
            && isValidOptionalState(request.resource.data)
            && isValidOptionalNote(request.resource.data)
            && isValidOptionalLedgerCount(uid, ledgerId, request.resource.data);

          allow delete: if isOwner(uid);
        }
      }

      // Account-wide app state that is not itself ledger data -- currently
      // just which ledger is active, so reopening the app (on any device)
      // returns to it. Fully overwritten on every write (no partial-update
      // immutability concerns), so create and update share one rule.
      match /settings/app {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['activeLedgerId', 'updatedAt'])
          && request.resource.data.keys().hasAll(['activeLedgerId', 'updatedAt'])
          && request.resource.data.activeLedgerId is string
          && request.resource.data.activeLedgerId.size() > 0
          && request.resource.data.updatedAt == request.time;

        // The client deletes this doc as the last step of deleting the
        // whole account (see data/account.ts's deleteAllUserData) -- after
        // every ledger and its days are already gone.
        allow delete: if isOwner(uid);
      }

      // No other documents are permitted under settings/.
      match /settings/{document} {
        allow read, write: if false;
      }
    }
  }
}

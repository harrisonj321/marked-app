rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny-by-default baseline. No application data model exists yet.
    // Scoped, schema-validated rules for tracker/user data are added
    // when the data layer is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

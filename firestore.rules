rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTrackerName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 60
        && name.matches('.*\\S.*');
    }

    function isDayState(state) {
      return state in ['did', 'didnt'];
    }

    // -- Daily entry helpers -------------------------------------------
    // A daily document is an exception/context record: every field on it
    // is optional except updatedAt, and at least one of state/note/count
    // must be present (otherwise the document should not exist at all).

    function hasKey(data, key) {
      return key in data.keys();
    }

    function hasAtLeastOneExplicitDailyField(data) {
      return hasKey(data, 'state') || hasKey(data, 'note') || hasKey(data, 'count');
    }

    function isValidOptionalState(data) {
      return !hasKey(data, 'state') || isDayState(data.state);
    }

    function isValidNote(note) {
      return note is string
        && note.size() > 0
        && note.size() <= 120
        && note.matches('.*\\S.*');
    }

    function isValidOptionalNote(data) {
      return !hasKey(data, 'note') || isValidNote(data.note);
    }

    function isValidCount(count) {
      return count is int && count >= 2 && count <= 99;
    }

    // A count's validity depends on the day's *effective* state, which
    // requires the tracker's configured default when no explicit state is
    // present on this write.
    function effectiveDailyState(uid, data) {
      return hasKey(data, 'state')
        ? data.state
        : get(/databases/$(database)/documents/users/$(uid)/tracker/config).data.defaultState;
    }

    function isValidOptionalCount(uid, data) {
      return !hasKey(data, 'count')
        || (isValidCount(data.count) && effectiveDailyState(uid, data) == 'did');
    }

    match /users/{uid} {

      // Single tracker config per user, at a fixed document id so no
      // alternate path can create a second tracker for the same user.
      match /tracker/config {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && request.resource.data.keys().hasAll(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && isDateKey(request.resource.data.startDate)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Only name, defaultState, and updatedAt may change after
        // creation. defaultState is user-correctable from Settings; the
        // client pins each day's current state onto its own document
        // before this write, so no already-recorded day's meaning
        // changes -- only days with no document re-resolve.
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone == resource.data.timezone
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // No other documents are permitted under tracker/.
      match /tracker/{document} {
        allow read, write: if false;
      }

      // A daily document represents only the explicit, non-default facts
      // for that day (state override, note, occurrence count); it is
      // fully replaced or removed, never partially patched.
      match /days/{dayId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isDateKey(dayId)
          && request.resource.data.keys().hasAll(['updatedAt'])
          && request.resource.data.keys().hasOnly(['state', 'note', 'count', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && hasAtLeastOneExplicitDailyField(request.resource.data)
          && isValidOptionalState(request.resource.data)
          && isValidOptionalNote(request.resource.data)
          && isValidOptionalCount(uid, request.resource.data);

        allow delete: if isOwner(uid);
      }
    }
  }
}

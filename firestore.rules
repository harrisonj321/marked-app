rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTrackerName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 60
        && name.matches('.*\\S.*');
    }

    function isDayState(state) {
      return state in ['did', 'didnt'];
    }

    match /users/{uid} {

      // Single tracker config per user, at a fixed document id so no
      // alternate path can create a second tracker for the same user.
      match /tracker/config {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && request.resource.data.keys().hasAll(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && isDayState(request.resource.data.defaultState)
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && isDateKey(request.resource.data.startDate)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Only name and updatedAt may ever change after creation.
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['name', 'defaultState', 'timezone', 'startDate', 'createdAt', 'updatedAt']
             )
          && isTrackerName(request.resource.data.name)
          && request.resource.data.defaultState == resource.data.defaultState
          && request.resource.data.timezone == resource.data.timezone
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // No other documents are permitted under tracker/.
      match /tracker/{document} {
        allow read, write: if false;
      }

      // A daily document represents only a non-default override for that
      // day; it is fully replaced or removed, never partially patched.
      match /days/{dayId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isDateKey(dayId)
          && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.keys().hasAll(['state', 'updatedAt'])
          && isDayState(request.resource.data.state)
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(uid);
      }
    }
  }
}
